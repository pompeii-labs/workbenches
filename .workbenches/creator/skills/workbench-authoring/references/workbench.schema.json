{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://workbenches.dev/schemas/v0/workbench.schema.json",
    "title": "Workbench manifest spec 0",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "spec",
        "version",
        "name",
        "runner",
        "model",
        "instructions",
        "runtime"
    ],
    "allOf": [
        {
            "if": {
                "required": ["docker"],
                "properties": {
                    "docker": { "required": ["engine"] }
                }
            },
            "then": {
                "properties": {
                    "runtime": { "const": "docker" }
                }
            }
        }
    ],
    "properties": {
        "spec": { "const": 0 },
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "runner_config": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 },
        "skills": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
        },
        "tools": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
        },
        "mcps": {
            "type": "array",
            "items": { "$ref": "#/$defs/mcp" },
            "default": []
        },
        "env": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/environment" },
            "default": {}
        },
        "workspaces": {
            "type": "object",
            "propertyNames": {
                "pattern": "^(?!primary$)[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": { "$ref": "#/$defs/workspace" },
            "default": {}
        },
        "runtime": { "type": "string", "minLength": 1 },
        "image": {
            "oneOf": [
                { "type": "string", "minLength": 1 },
                { "$ref": "#/$defs/imageBuild" }
            ]
        },
        "docker": {
            "$ref": "#/$defs/docker"
        }
    },
    "$defs": {
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "routes": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/modelRoute" }
                }
            }
        },
        "modelRoute": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider"],
            "properties": {
                "provider": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "model": { "type": "string", "minLength": 1 }
            }
        },
        "imageBuild": {
            "type": "object",
            "additionalProperties": false,
            "required": ["build"],
            "properties": {
                "build": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 }
            }
        },
        "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "required": { "type": "boolean", "default": true }
            }
        },
        "workspace": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "required": { "type": "boolean", "default": true },
                "access": {
                    "enum": ["read-only", "read-write"],
                    "default": "read-only"
                }
            }
        },
        "docker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "engine": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode"],
                    "properties": {
                        "mode": { "const": "host" }
                    }
                }
            }
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "transport": { "const": "http", "default": "http" },
                "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": { "type": "string", "minLength": 1 },
                    "default": {}
                }
            }
        }
    }
}
