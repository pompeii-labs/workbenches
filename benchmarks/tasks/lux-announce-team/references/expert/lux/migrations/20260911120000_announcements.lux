TCREATE announcements id UUID PRIMARY KEY DEFAULT uuid(), created_at TIMESTAMP DEFAULT now(), team_id UUID REFERENCES teams(id) ON DELETE CASCADE, author_id STR REFERENCES auth.users(id) ON DELETE CASCADE, title STR NOT NULL, body STR NOT NULL

# Users can see the announcements of teams they are a member of
GRANT read ON announcements WHERE team_id IN ( SELECT team_id FROM members WHERE user_id = auth.uid() )
