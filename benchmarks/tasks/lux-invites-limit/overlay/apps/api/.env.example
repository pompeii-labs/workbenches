# Copy to .env: `lux start` prints these values for local dev
LUX_URL=http://localhost:8080
# Server-only key with full access. Never expose to the browser.
LUX_SECRET_KEY=lux_sec_xxx
# Override the port this instance listens on (useful when running more than
# one API instance against the same Lux project).
PORT=3000
# Invite rate limit, per team.
RATE_LIMIT_MAX_INVITES=5
RATE_LIMIT_WINDOW_SECONDS=3600
