{
    "name": "@pompeii-labs/workbench",
    "version": "0.0.0",
    "private": true,
    "packageManager": "bun@1.3.11",
    "type": "module",
    "bin": {
        "workbench": "./src/cli.ts",
        "wb": "./src/cli.ts"
    },
    "scripts": {
        "build": "bun build --compile --minify --outfile dist/workbench src/cli.ts",
        "check": "bun run typecheck && bun run lint && bun test",
        "commitlint": "commitlint",
        "format": "biome check --write .",
        "lint": "biome check .",
        "prepare": "husky",
        "run": "bun src/cli.ts",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/bun": "latest",
        "husky": "^9.1.7",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "citty": "^0.2.2"
    }
}
