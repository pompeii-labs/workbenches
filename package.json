{
    "name": "@pompeii-labs/workbench",
    "version": "0.0.0",
    "private": true,
    "description": "Open standard and reference engine for portable expert AI environments.",
    "license": "Apache-2.0",
    "author": "Pompeii Labs, Inc. <hello@pompeiilabs.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pompeii-labs/workbenches.git"
    },
    "bugs": {
        "url": "https://github.com/pompeii-labs/workbenches/issues"
    },
    "keywords": [
        "ai",
        "agents",
        "cli",
        "open-standard",
        "workbench"
    ],
    "packageManager": "bun@1.3.11",
    "type": "module",
    "bin": {
        "workbench": "./src/cli.ts",
        "wb": "./src/cli.ts"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "bun run typecheck && bun run lint && bun test",
        "commitlint": "commitlint",
        "format": "biome check --write .",
        "lint": "biome check .",
        "prepare": "husky",
        "release:package": "bun scripts/package-release.ts",
        "release:verify": "bun scripts/verify-release.ts",
        "run": "bun --preload @opentui/solid/preload src/cli.ts",
        "test": "bun test --preload @opentui/solid/preload",
        "test:coverage": "bun test --preload @opentui/solid/preload --coverage",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/bun": "latest",
        "husky": "^9.1.7",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@opentui/solid": "^0.5.4",
        "citty": "^0.2.2",
        "marked": "^18.0.7",
        "picocolors": "^1.1.1",
        "solid-js": "1.9.12"
    }
}
