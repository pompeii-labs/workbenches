{
    "name": "@pompeii-labs/workbench",
    "version": "1.0.1",
    "private": true,
    "description": "Open standard and reference engine for portable expert AI environments.",
    "license": "Apache-2.0",
    "author": "Pompeii Labs, Inc. <hello@pompeiilabs.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pompeii-labs/workbenches.git"
    },
    "bugs": {
        "url": "https://github.com/pompeii-labs/workbenches/issues"
    },
    "keywords": [
        "ai",
        "agents",
        "cli",
        "open-standard",
        "workbench"
    ],
    "files": [
        "src",
        "schemas",
        "package.json",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "packageManager": "bun@1.3.11",
    "type": "module",
    "bin": {
        "workbench": "./src/cli.ts",
        "wb": "./src/cli.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./types": "./src/types.ts",
        "./manifest": "./src/workbench/manifest.ts",
        "./requirements": "./src/workbench/requirements.ts",
        "./runtimes/selection": "./src/workbench/runtimes.ts",
        "./events": "./src/runs/events.ts",
        "./models": "./src/models/index.ts",
        "./outcomes": "./src/outcomes/core/index.ts",
        "./outcomes/disk": "./src/outcomes/index.ts",
        "./runners/files": "./src/runners/types.ts",
        "./runners/files/disk": "./src/runners/files/disk.ts",
        "./runners/files/memory": "./src/runners/files/memory.ts",
        "./runners/session": "./src/runners/session.ts",
        "./runners/opencode/adapter": "./src/runners/opencode/adapter.ts",
        "./runners/opencode/runner": "./src/runners/opencode/runner.ts",
        "./runners/opencode/session": "./src/runners/opencode/session.ts",
        "./runners/opencode/server": "./src/runners/opencode/server.ts",
        "./runners/opencode/progress": "./src/runners/opencode/progress.ts",
        "./runners/opencode/events": "./src/runners/opencode/events.ts",
        "./runners/opencode/invocation": "./src/runners/opencode/invocation.ts",
        "./runners/opencode/skills": "./src/runners/opencode/skills.ts",
        "./runners/context": "./src/runners/context/stage.ts",
        "./runtimes": "./src/runtimes/index.ts",
        "./runtimes/contracts": "./src/runtimes/contracts.ts",
        "./runtimes/daytona": "./src/runtimes/daytona/index.ts",
        "./runtimes/e2b": "./src/runtimes/e2b/index.ts",
        "./runtimes/e2b/contracts": "./src/runtimes/e2b/contracts.ts",
        "./runtimes/remote/disk": "./src/runtimes/remote/disk/transfer.ts",
        "./runtimes/assets": "./src/runtimes/staging/source.ts",
        "./runtimes/assets/disk": "./src/runtimes/staging/disk.ts",
        "./runtimes/staging": "./src/runtimes/staging/index.ts",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "bun run typecheck && bun run lint && bun run test",
        "commitlint": "commitlint",
        "format": "biome check --write .",
        "lint": "biome check .",
        "prepare": "husky",
        "release:package": "bun scripts/package-release.ts",
        "release:verify": "bun scripts/verify-release.ts",
        "run": "bun --preload @opentui/solid/preload src/cli.ts",
        "test": "bun test --preload @opentui/solid/preload --preload ./test/setup.ts",
        "test:coverage": "bun test --preload @opentui/solid/preload --preload ./test/setup.ts --coverage",
        "test:daytona": "DAYTONA_E2E=1 bun test --preload ./test/setup.ts test/live/daytona.test.ts",
        "test:docker": "WORKBENCH_DOCKER_E2E=1 bun test --preload ./test/setup.ts test/docker.e2e.test.ts",
        "test:docker:sessions": "WORKBENCH_DOCKER_SESSION_E2E=1 bun test --preload ./test/setup.ts test/docker.e2e.test.ts",
        "test:e2b": "WORKBENCH_E2B_E2E=1 bun test --preload ./test/setup.ts test/e2b.e2e.test.ts",
        "test:e2b:sessions": "WORKBENCH_E2B_E2E=1 WORKBENCH_E2B_SESSION_E2E=1 bun test --preload ./test/setup.ts test/e2b.e2e.test.ts",
        "test:outcomes:harnesses": "WORKBENCH_OUTCOME_HARNESS_E2E=1 bun test --preload ./test/setup.ts test/outcomes/harness.e2e.test.ts test/runs/execution.e2e.test.ts",
        "test:outcomes:browser": "WORKBENCH_OUTCOME_BROWSER_E2E=1 bun test --preload ./test/setup.ts test/outcomes/browser.e2e.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/tar-stream": "^3.1.4",
        "@types/bun": "latest",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "husky": "^9.1.7",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@clack/prompts": "^1.5.1",
        "@opentui/solid": "^0.5.4",
        "citty": "^0.2.2",
        "e2b": "2.51.0",
        "marked": "^18.0.7",
        "picocolors": "^1.1.1",
        "solid-js": "1.9.12",
        "tar-stream": "^3.2.0"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "fast-uri": "3.1.8",
        "js-yaml": "4.3.2",
        "seroval": "1.6.8",
        "seroval-plugins": "1.6.8"
    }
}
