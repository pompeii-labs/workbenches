{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://workbenches.dev/schemas/events/v0/workbench-event.schema.json",
    "title": "Workbench event protocol v0",
    "type": "object",
    "$defs": {
        "infrastructure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "duration_ms", "cost"],
            "properties": {
                "provider": { "type": "string", "minLength": 1 },
                "duration_ms": { "type": "number", "minimum": 0 },
                "maximum_duration_ms": { "type": "number", "minimum": 0 },
                "resources": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu_count": { "type": "number", "minimum": 0 },
                        "memory_mb": { "type": "number", "minimum": 0 }
                    }
                },
                "cost": {
                    "oneOf": [
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["kind", "currency", "amount_usd", "source"],
                            "properties": {
                                "kind": { "const": "estimated" },
                                "currency": { "const": "USD" },
                                "amount_usd": {
                                    "type": "number",
                                    "minimum": 0
                                },
                                "source": { "type": "string", "minLength": 1 }
                            }
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["kind", "currency"],
                            "properties": {
                                "kind": { "const": "unavailable" },
                                "currency": { "const": "USD" }
                            }
                        }
                    ]
                }
            }
        }
    },
    "additionalProperties": false,
    "required": [
        "protocol",
        "run_id",
        "sequence",
        "timestamp",
        "type",
        "runner",
        "data"
    ],
    "properties": {
        "protocol": { "const": 0 },
        "run_id": {
            "type": "string",
            "pattern": "^wb_[a-z0-9]{20,64}$"
        },
        "sequence": { "type": "integer", "minimum": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": {
            "enum": [
                "run.started",
                "run.ready",
                "repository.preparing",
                "repository.ready",
                "repository.checks",
                "delivery.started",
                "delivery.completed",
                "delivery.failed",
                "authentication.requested",
                "authentication.completed",
                "turn.started",
                "turn.completed",
                "output.text",
                "tool.started",
                "tool.completed",
                "file.changed",
                "input.requested",
                "input.accepted",
                "input.queued",
                "input.delivered",
                "input.rejected",
                "question.requested",
                "question.answered",
                "question.rejected",
                "usage.updated",
                "outcome.available",
                "outcome.failed",
                "run.completed",
                "run.failed",
                "run.cancelled",
                "runner.event"
            ]
        },
        "runner": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
    },
    "allOf": [
        {
            "if": { "properties": { "type": { "const": "repository.checks" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": [
                            "pull_request",
                            "state",
                            "truncated",
                            "checks",
                            "statuses",
                            "workflows",
                            "jobs"
                        ],
                        "properties": {
                            "state": {
                                "enum": [
                                    "none",
                                    "pending",
                                    "failed",
                                    "incomplete",
                                    "passed"
                                ]
                            },
                            "truncated": { "type": "boolean" },
                            "pull_request": {
                                "type": "object",
                                "required": [
                                    "number",
                                    "url",
                                    "head",
                                    "branch",
                                    "state",
                                    "merged",
                                    "draft"
                                ],
                                "properties": {
                                    "number": { "type": "integer", "minimum": 1 },
                                    "url": { "type": "string", "format": "uri" },
                                    "head": {
                                        "type": "string",
                                        "pattern": "^[a-f0-9]{40}$"
                                    },
                                    "branch": { "type": "string", "minLength": 1 },
                                    "state": { "enum": ["open", "closed"] },
                                    "merged": { "type": "boolean" },
                                    "draft": { "type": "boolean" }
                                }
                            },
                            "checks": { "type": "array", "maxItems": 100 },
                            "statuses": { "type": "array", "maxItems": 100 },
                            "workflows": { "type": "array", "maxItems": 20 },
                            "jobs": { "type": "array", "maxItems": 2000 }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "type": { "enum": ["repository.preparing", "repository.ready"] }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["repository", "revision"],
                        "properties": {
                            "repository": { "type": "string", "minLength": 3 },
                            "revision": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{40}$"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "delivery.started" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["repository", "outcome_id"],
                        "properties": {
                            "repository": { "type": "string", "minLength": 3 },
                            "outcome_id": {
                                "type": "string",
                                "pattern": "^wbo_[a-z0-9]{20,64}$"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "type": { "enum": ["delivery.completed", "delivery.failed"] }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": [
                            "version",
                            "run_id",
                            "outcome_id",
                            "repository",
                            "revision",
                            "branch",
                            "base_branch",
                            "created_at",
                            "state"
                        ],
                        "properties": {
                            "version": { "const": 1 },
                            "run_id": {
                                "type": "string",
                                "pattern": "^wb_[a-z0-9]{20,64}$"
                            },
                            "outcome_id": {
                                "type": "string",
                                "pattern": "^wbo_[a-z0-9]{20,64}$"
                            },
                            "repository": { "type": "string", "minLength": 3 },
                            "revision": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{40}$"
                            },
                            "branch": { "type": "string", "minLength": 1 },
                            "base_branch": { "type": "string", "minLength": 1 },
                            "created_at": { "type": "string", "format": "date-time" },
                            "state": { "enum": ["published", "failed", "unchanged"] },
                            "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                            "message": { "type": "string" },
                            "pull_request": {
                                "type": "object",
                                "required": ["number", "url"],
                                "properties": {
                                    "number": { "type": "integer", "minimum": 1 },
                                    "url": { "type": "string", "format": "uri" }
                                }
                            }
                        },
                        "allOf": [
                            {
                                "if": {
                                    "properties": { "state": { "const": "published" } }
                                },
                                "then": {
                                    "required": ["tree", "commit", "pull_request"]
                                }
                            }
                        ]
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "delivery.failed" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "properties": { "state": { "const": "failed" } }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "delivery.completed" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "properties": {
                            "state": { "enum": ["published", "unchanged"] }
                        }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "output.text" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["text"],
                        "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "text": { "type": "string" }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": { "type": { "const": "outcome.available" } }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": [
                            "outcome_id",
                            "completeness",
                            "application_state",
                            "changesets",
                            "artifacts",
                            "links",
                            "warnings"
                        ],
                        "properties": {
                            "outcome_id": {
                                "type": "string",
                                "pattern": "^wbo_[a-z0-9]{20,64}$"
                            },
                            "completeness": {
                                "enum": ["complete", "partial"]
                            },
                            "turn_index": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                            },
                            "application_state": {
                                "enum": ["pending", "present", "applied"]
                            },
                            "changesets": { "type": "integer", "minimum": 0 },
                            "artifacts": { "type": "integer", "minimum": 0 },
                            "links": { "type": "integer", "minimum": 0 },
                            "warnings": { "type": "integer", "minimum": 0 },
                            "summary": { "type": "string" }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": { "type": { "const": "outcome.failed" } }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["message", "turn_index"],
                        "properties": {
                            "message": { "type": "string", "minLength": 1 },
                            "turn_index": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": { "type": { "enum": ["tool.started", "tool.completed"] } }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["id", "name"],
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "title": { "type": "string" },
                            "target": { "type": "string" },
                            "description": { "type": "string" },
                            "status": { "enum": ["completed", "failed"] },
                            "duration_ms": { "type": "number", "minimum": 0 },
                            "outcome_id": {
                                "type": "string",
                                "pattern": "^wbo_[a-z0-9]{20,64}$"
                            },
                            "error_code": { "type": "string" },
                            "message": { "type": "string" }
                        }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "usage.updated" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["kind"],
                        "properties": {
                            "kind": { "const": "delta" },
                            "total_tokens": { "type": "integer", "minimum": 0 },
                            "input_tokens": { "type": "integer", "minimum": 0 },
                            "output_tokens": { "type": "integer", "minimum": 0 },
                            "reasoning_tokens": { "type": "integer", "minimum": 0 },
                            "cache_read_tokens": { "type": "integer", "minimum": 0 },
                            "cache_write_tokens": { "type": "integer", "minimum": 0 },
                            "cost_usd": { "type": "number", "minimum": 0 }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": { "type": { "const": "question.requested" } }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["id", "questions"],
                        "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "questions": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "question",
                                        "options",
                                        "multiple",
                                        "custom"
                                    ],
                                    "properties": {
                                        "question": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "header": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "options": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "required": ["label"],
                                                "properties": {
                                                    "label": {
                                                        "type": "string",
                                                        "minLength": 1
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "minLength": 1
                                                    }
                                                }
                                            }
                                        },
                                        "multiple": { "type": "boolean" },
                                        "custom": { "type": "boolean" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "type": {
                        "enum": ["question.answered", "question.rejected"]
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "answer_count": {
                                "type": "integer",
                                "minimum": 0
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "type": {
                        "enum": ["run.completed", "run.failed", "run.cancelled"]
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "properties": {
                            "duration_ms": { "type": "number", "minimum": 0 },
                            "infrastructure": {
                                "$ref": "#/$defs/infrastructure"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "run.failed" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["message"],
                        "properties": { "message": { "type": "string" } }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "runner.event" } } },
            "then": {
                "properties": {
                    "data": {
                        "type": "object",
                        "required": ["native_type"],
                        "properties": { "native_type": { "type": "string" } }
                    }
                }
            }
        }
    ]
}
