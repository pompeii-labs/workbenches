{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023"],
        "types": ["bun"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
